[Unit]
Description=Send Amy Jaffe Nutrition weekly analytics email
After=network-online.target amy-jaffe-analytics.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/amy-jaffe-analytics
EnvironmentFile=/etc/amy-jaffe-analytics.env
ExecStart=/usr/bin/node /opt/amy-jaffe-analytics/server/weekly-analytics-email.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
